<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>card</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>card</name>
    <description>card</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Config Client —— 啟動時去 Config Server (8071) 拿 config/card.yml
             （檔名 = spring.application.name），並帶進 @RefreshScope、/actuator/refresh。
             版本由下方 BOM 決定，不寫 <version>。

             ⚠ 必須在 application.yaml 設 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）：
                 import: "configserver:http://localhost:8071/"           連不上就失敗
                 import: "optional:configserver:http://localhost:8071/"  連不上改用本地設定
               容器裡要把 localhost 換成服務名 configserver。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                        ===================================================================
                         Jib：Google 的容器建置工具（card 模組用這個方式）
                        ===================================================================

                        三個模組刻意用三種不同的建 image 方式，方便對照：
                            account → Dockerfile（自己寫，完全掌控）
                            loan    → Buildpacks（mvn spring-boot:build-image）
                            card    → Jib（這個）

                        Jib 最大特色：jib:build 可以「不需要 Docker」直接推到 registry，
                        因為它在 JVM 裡直接組出 image 的層並上傳，繞過 Docker daemon。
                        這在 CI 環境很有用（不必在 CI 裡跑 Docker in Docker）。

                        ===================================================================
                         三個 goal 的差別
                        ===================================================================
                        mvn jib:dockerBuild   建到本機 Docker（需要 Docker 在跑）
                        mvn jib:build         直接推到 registry（不需要 Docker，要先登入）
                        mvn jib:buildTar      產生 tar 檔（不需要 Docker）

                        ⚠ Jib「不會自動編譯」，指令前面一定要加 compile：
                              mvnw compile jib:dockerBuild
                          漏掉會失敗，訊息是
                              Obtaining project build output files failed;
                              make sure you have compiled your project
                          （spring-boot:build-image 會自動跑 package，Jib 不會。）

                        ===================================================================
                         各區塊的作用
                        ===================================================================
                        <from>       基底 image。Jib 會依專案 Java 版本自動挑，但 3.5.2
                                     不一定認得 Java 25，所以明確指定；同時與 account 的
                                     Dockerfile 使用同一個基底，兩者行為才一致。

                        <to>         產出的 image 名稱，變數會自動展開：
                                       ${project.artifactId} → card
                                       ${project.version}    → 0.0.1-SNAPSHOT
                                     ⚠ 原本只寫 myimage 是不能用的，因為會被解析成
                                       docker.io/library/myimage:latest，而 library 是
                                       Docker Hub 官方命名空間，沒有權限 push。

                        <container>  等同 Dockerfile 的 EXPOSE / ENV / USER：
                                       ports       → EXPOSE
                                       environment → ENV（預設用記憶體資料庫，語意明確
                                                     表示容器內資料不持久）
                                       user        → USER（避免以 root 執行容器）

                        ===================================================================
                         操作指令
                        ===================================================================
                        建 image：
                            cd D:\Fork\github\springboot-microservices\card
                            .\mvnw compile jib:dockerBuild

                        跑起來（d 參數背景執行、name 參數命名為 card）：
                            docker run -d (name=card) -p 9000:9000 anthonysk/card:0.0.1-SNAPSHOT

                        check db：docker logs card | Select-String "jdbc:h2"

                        ⚠ port 映射是 9000:9000，不是 9000:8080！
                          因為 card 的 server.port 設定是 9000，容器內 App 聽的就是 9000。
                          寫錯的話容器會正常啟動，但永遠連不上，且沒有任何錯誤訊息。

                        驗證：
                            curl http://localhost:9000/actuator/health
                            瀏覽器：http://localhost:9000/swagger-ui/index.html

                        收工：
                            docker rm -f card
                    -->
                    <from>
                        <!--
                            docker:// 前綴 = 直接使用「本機 Docker 已有的 image」，
                            不去 registry 抓，因此不需要 registry 驗證。

                            ⚠ 不加這個前綴的話 Jib 會去 Docker Hub 抓 manifest，
                              而 Docker Desktop 的憑證存放區若有無效登入資訊，
                              就會失敗並回報 incorrect username or password。

                            前提：本機要先有這個 image
                                docker pull eclipse-temurin:25-jre-alpine
                        -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <port>9000</port>
                        </ports>
                        <environment>
                            <SPRING_DATASOURCE_URL>jdbc:h2:mem:carddb</SPRING_DATASOURCE_URL>
                        </environment>
                        <user>nobody</user>
                        <!--
                            OCI 標準的 image label（純 metadata，不影響程式執行）。
                            查看方式：docker image inspect 的 Config.Labels 欄位

                            推到 ghcr.io 時，GitHub 的 package 頁面會用這些 label 顯示
                            描述，並「嘗試」把 image 連結到 source 指向的 repo。

                            🔑 為什麼 Jib 只設 label 就夠，account 卻還要額外的 annotation？
                               因為 Jib 產出的是舊的 Docker v2 manifest，該格式不支援
                               annotation，GitHub 只能退回去讀 config label。
                               而 account 用 buildx 產出的是 OCI manifest，GitHub 會優先
                               找 manifest annotation，找不到就空白（不會退回讀 label）。
                               → 差異來自 manifest 格式，不是設定寫錯。

                            ⚠ 自動連結 repo「不保證成功」。官方文件指出命令列推送只有用
                              GitHub Actions + GITHUB_TOKEN 才保證自動連結；手動推送若沒
                              連上，要到 Package settings 手動 Connect repository。
                        -->
                        <labels>
                            <org.opencontainers.image.title>card-service</org.opencontainers.image.title>
                            <org.opencontainers.image.description>卡片資料的 REST API</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
