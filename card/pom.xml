<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>card</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>card</name>
    <description>card</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <!-- MySQL 的 JDBC driver。版本由 Boot 的 BOM 管，不用寫。
             ⚠ scope 是 runtime —— 程式碼不該 import driver 類別，只有 JVM 執行期要載入它。
             🔑 application.yaml 刻意「不寫」driverClassName —— Spring Boot 會從連線字串
                jdbc:mysql://... 推斷出來。少一個換資料庫時容易改漏的地方。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Config Client —— 啟動時向 Config Server 拿 configyml/card.yml
             （檔名 = spring.application.name），並帶進 /actuator/refresh。
             ⚠ 必須搭配 application.yaml 的 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder —— 提供 /actuator/busrefresh，
             打一次讓所有服務重抓設定。
             ⚠ 四個服務都要加，少一個那個服務收不到廣播且沒有錯誤訊息。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時連不上 broker。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- OpenTelemetry —— 分散式追蹤（Trace）。
             一個依賴帶進 micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp，
             Java 程式碼零改動：HTTP 進出、Feign 呼叫、DB 查詢由框架自動埋點。
             ⚠ 還要 Tempo 容器接收 span，不然只是不斷嘗試送出然後失敗。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                        Jib 建 image（不必寫 Dockerfile）：
                            ./mvnw compile jib:dockerBuild   建到本機 Docker
                            ./mvnw compile jib:build         直接推 registry（不需要 Docker）
                            ./mvnw compile jib:buildTar      產生 tar 檔

                        jib:build 不經過 Docker daemon —— 它在 JVM 裡組出 image 的層直接
                        上傳，所以 CI 環境不必跑 Docker in Docker。

                        ⚠ compile 不能省，Jib 不會自己編譯（spring-boot:build-image 會）。
                          漏掉的錯誤訊息是 Obtaining project build output files failed。

                        ⚠ <to> 的名稱要帶命名空間。只寫 myimage 會被解析成
                          docker.io/library/myimage:latest，library 是 Docker Hub 官方
                          命名空間，沒有權限 push。

                        <container> 等同 Dockerfile 的 EXPOSE / ENV / USER。
                    -->
                    <from>
                        <!-- 基底 image。

                             為什麼要自己指定：不寫的話 Jib 會自己猜一個，但 3.5.2 比
                             Java 25 舊，可能猜錯。而且指定成跟 account 的 Dockerfile
                             一樣，兩個容器裡的環境才一致（都有 wget，compose 的
                             healthcheck 才用得了）。

                             docker:// 的意思是「用本機 Docker 已經有的那份，不要去網路抓」。
                             ⚠ 不加這個前綴的話，Jib 會連去 Docker Hub，順便套用 Docker
                               Desktop 存的登入憑證。那份憑證如果過期了就會失敗，訊息是
                               incorrect username or password —— 但這個 image 明明是公開的、
                               根本不用登入，錯誤訊息會害你往帳號密碼的方向查。

                             ⚠ 用 docker:// 的前提是本機真的有這個 image：
                                 docker pull eclipse-temurin:25-jre-alpine -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <port>9000</port>
                        </ports>
                        <environment>
                            <!-- ⚠ 寫「容器內的」位址而不是 localhost —— 容器裡的 localhost 是它自己。
                                 application.yaml 的預設值是 localhost:3306（給 IntelliJ 用的）。 -->
                            <SPRING_DATASOURCE_URL>jdbc:mysql://mysql:3306/carddb</SPRING_DATASOURCE_URL>
                        </environment>
                        <user>nobody</user>
                        <!-- OCI image label（純 metadata），ghcr.io 的 package 頁面靠它
                             顯示描述。
                             🔑 Jib 產的是 Docker v2 manifest，GitHub 讀得到 config label；
                                account 用 buildx 產 OCI manifest，GitHub 只讀 manifest
                                annotation，所以那邊要額外設定。 -->
                        <labels>
                            <org.opencontainers.image.title>card-service</org.opencontainers.image.title>
                            <org.opencontainers.image.description>卡片資料的 REST API</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
