<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>configserver</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>configserver</name>
    <description>configserver</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 提供 Config Server API、Git／native 設定來源，以及加密與 {cipher} 解密。主類別仍需加上 @EnableConfigServer。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-config-server</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ：讓 /monitor 收到 webhook 後廣播 refresh 事件。
             需要 RabbitMQ 才能發送通知。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Config Monitor —— 提供 POST /monitor 接收 git webhook：解析 payload，
             把 configyml/account.yml 對應成 account，經 Bus 只通知有變的服務。
             （/actuator/busrefresh 則是無條件通知全部。）
             ⚠ 一般 @RestController，不在 /actuator 底下，不用加進 exposure.include。
             ⚠ POST only；預設不驗證 webhook secret，對外開放要加保護。
             本機測試（GitHub 連不到 localhost）：
               Invoke-RestMethod http://localhost:8071/monitor -Method Post `
                 -Headers @{"X-Github-Event"="push"} -ContentType "application/json" `
                 -Body '{"commits":[{"modified":["configyml/account.yml"]}]}' -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-config-monitor</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Jib 不需要 Dockerfile；先 compile，再執行 jib:dockerBuild 建立本機 image。 -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 使用與其他服務相同的 Java／Alpine 基底；docker:// 代表使用本機 image。
                             若本機沒有，先執行 docker pull eclipse-temurin:25-jre-alpine。 -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- 對應 Dockerfile 的 EXPOSE。 -->
                            <port>8071</port>
                        </ports>
                        <!-- 使用非 root 使用者執行。 -->
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>configserver</org.opencontainers.image.title>
                            <org.opencontainers.image.description>Spring Cloud Config Server（git 後端 + Bus 廣播 + webhook monitor）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
