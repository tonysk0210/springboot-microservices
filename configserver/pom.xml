<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>configserver</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>configserver</name>
    <description>configserver</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Config Server 本體 —— 提供 /{application}/{profile} 端點與 git/native 後端，
             以及 /encrypt、/decrypt 和 {cipher} 自動解密。
             ⚠ 光加依賴不夠，主類別要有 @EnableConfigServer。
             ⚠ 它連帶帶進 config-client，所以 configserver 也會嘗試 refresh 自己
               （見 application.yaml 的 spring.cloud.bus.refresh.enabled）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-config-server</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder。
             configserver 需要它是為了「發送」—— 下面的 monitor 收到 webhook 後，
             要靠 Bus 才能把 refresh 事件廣播出去（不是為了接收）。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時會無限重連。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Config Monitor —— 提供 POST /monitor 接收 git webhook：解析 payload，
             把 configyml/account.yml 對應成 account，經 Bus 只通知有變的服務。
             （/actuator/busrefresh 則是無條件通知全部。）
             ⚠ 一般 @RestController，不在 /actuator 底下，不用加進 exposure.include。
             ⚠ POST only；預設不驗證 webhook secret，對外開放要加保護。
             本機測試（GitHub 連不到 localhost）：
               Invoke-RestMethod http://localhost:8071/monitor -Method Post `
                 -Headers @{"X-Github-Event"="push"} -ContentType "application/json" `
                 -Body '{"commits":[{"modified":["configyml/account.yml"]}]}' -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-config-monitor</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Jib 建 image（不用寫 Dockerfile，跟 card 同一套做法）：
                     ./mvnw compile jib:dockerBuild
                 ⚠ compile 不能省，Jib 不會自己編譯。漏掉的錯誤訊息是
                   Obtaining project build output files failed。 -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 跟 account / card 同一個基底：alpine 有 wget（compose 的
                             healthcheck 要用）和 sh（進去除錯要用）。
                             docker:// = 用本機已經有的，不去網路抓（理由見 card/pom.xml）。
                             ⚠ 前提是本機真的有：docker pull eclipse-temurin:25-jre-alpine -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- 等同 Dockerfile 的 EXPOSE -->
                            <port>8071</port>
                        </ports>
                        <!-- 刻意不設 <environment>：ENCRYPT_KEY（機密）和
                             SPRING_RABBITMQ_HOST（只有容器裡才要指向服務名）都由
                             compose 在執行期提供，不該寫死進 image。 -->
                        <!-- 不要用 root 執行 -->
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>configserver</org.opencontainers.image.title>
                            <org.opencontainers.image.description>Spring Cloud Config Server（git 後端 + Bus 廣播 + webhook monitor）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
