<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>account</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>account</name>
    <description>account</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Config Client —— 啟動時向 Config Server 拿 configyml/account.yml
             （檔名 = spring.application.name），並帶進 /actuator/refresh。
             ⚠ 必須搭配 application.yaml 的 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder —— 提供 /actuator/busrefresh，
             打一次讓所有服務重抓設定。
             ⚠ 四個服務都要加，少一個那個服務收不到廣播且沒有錯誤訊息。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時連不上 broker。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Eureka Client —— 向註冊中心（http://localhost:8070）報到。
             啟動時做兩件事：把自己登記上去、把整份名冊抓回本機快取（預設 30 秒更新
             一次），之後呼叫別的服務就用服務名而不必寫死 http://loan:8090。

             ⚠ 必須搭配 application.yaml 的 eureka.client.service-url.defaultZone。
               沒設會退回預設的 localhost:8761，然後每隔幾秒噴一次
               「Cannot execute request on any known server」——
               而且那是 WARN 不是啟動失敗，很容易被當成雜訊忽略掉。

             ⚠ 不要加 @EnableEurekaClient —— 這個註解在 spring-cloud-netflix 5.0.2
               裡「已經不存在」（實測 jar 內找不到），加了直接編譯不過。
               @EnableDiscoveryClient 雖然還在，但從 Spring Cloud 2020.0 起也不需要了：
               classpath 上有這個 starter 就自動啟用。舊教材幾乎都還在叫你加。

             🔑 它會順便帶進 spring-cloud-starter-loadbalancer（實測確認），
                所以之後要做客戶端負載平衡不用再加依賴，@LoadBalanced 直接可用。
                這也是 Ribbon 退場後的替代品。

             ⚠ 它的傳遞依賴 com.netflix.eureka:eureka-client:2.0.6 把 httpclient
               釘死在 4.5.3（CVE-2020-13956，URI 解析問題，CVSS 5.3）。
               Spring Boot 的 BOM 只管 httpclient5，管不到 4.x 這條線，所以不會自動
               升級。要消掉掃描器的警告，在下方 dependencyManagement 補一筆
               org.apache.httpcomponents:httpclient:4.5.14 即可（純修補版，API 相容）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 23+ 需要顯式宣告 annotation processor，compile 與 testCompile 皆會套用 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
