<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>account</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>account</name>
    <description>account</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Config Client —— 啟動時向 Config Server 拿 configyml/account.yml
             （檔名 = spring.application.name），並帶進 /actuator/refresh。
             ⚠ 必須搭配 application.yaml 的 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder —— 提供 /actuator/busrefresh，
             打一次讓所有服務重抓設定。
             ⚠ 四個服務都要加，少一個那個服務收不到廣播且沒有錯誤訊息。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時連不上 broker。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Eureka Client —— 向註冊中心（http://localhost:8070）報到。
             啟動時做兩件事：把自己登記上去、把整份名冊抓回本機快取（預設 30 秒更新
             一次），之後呼叫別的服務就用服務名而不必寫死 http://loan:8090。

             ⚠ 必須搭配 application.yaml 的 eureka.client.service-url.defaultZone。
               沒設會退回預設的 localhost:8761，然後每隔幾秒噴一次
               「Cannot execute request on any known server」——
               而且那是 WARN 不是啟動失敗，很容易被當成雜訊忽略掉。

             ⚠ 不要加 @EnableEurekaClient —— 這個註解在 spring-cloud-netflix 5.0.2
               裡「已經不存在」（實測 jar 內找不到），加了直接編譯不過。
               @EnableDiscoveryClient 雖然還在，但從 Spring Cloud 2020.0 起也不需要了：
               classpath 上有這個 starter 就自動啟用。舊教材幾乎都還在叫你加。

             🔑 它會順便帶進 spring-cloud-starter-loadbalancer（實測確認），
                所以之後要做客戶端負載平衡不用再加依賴，@LoadBalanced 直接可用。
                這也是 Ribbon 退場後的替代品。

             ⚠ 它的傳遞依賴 com.netflix.eureka:eureka-client:2.0.6 把 httpclient
               釘死在 4.5.3（CVE-2020-13956，URI 解析問題，CVSS 5.3）。
               Spring Boot 的 BOM 只管 httpclient5，管不到 4.x 這條線，所以不會自動
               升級。要消掉掃描器的警告，在下方 dependencyManagement 補一筆
               org.apache.httpcomponents:httpclient:4.5.14 即可（純修補版，API 相容）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- OpenFeign —— 宣告式 HTTP 客戶端。你「只寫介面」，實作由 Feign 動態產生：
                 @FeignClient(name = "loan")
                 public interface LoanFeignClient {
                     @GetMapping("/api/fetch")
                     ResponseEntity<LoanDto> fetchLoan(@RequestParam String mobileNumber);
                 }
             之後 @Autowired 進來直接呼叫方法，不用碰 URL、不用組請求、不用解析 JSON。

             ⚠ 必須在主類別加 @EnableFeignClients，否則介面完全不會被掃到 ——
               沒有錯誤訊息，只有注入時的 NoSuchBeanDefinitionException。
               🔑 這點跟上面的 Eureka Client「剛好相反」：@EnableEurekaClient 已經被移除、
                  加了編譯不過；@EnableFeignClients 則實測仍存在於 jar 內，而且非加不可。

             🔑 Feign、LoadBalancer、Eureka 是「三層」，不是一套綁死的東西：
                     ① Feign             決定「怎麼發出請求」
                     ② LoadBalancer      把服務名變成位址、挑一台實例
                     ③ DiscoveryClient   名冊來源（Eureka / Consul / Nacos / K8s）
                Feign 只認識 ②，② 只認識 ③ 這個介面。所以哪天把 Eureka 換成 Consul，
                @FeignClient 那行完全不用動。
                ⚠ ② 的依賴不是這個 starter 提供的，是隨 eureka-client 進來的。

             🔑 name 和 url 決定「要不要走服務發現」，差一個參數而已：
                 @FeignClient(name = "loan")                        → 走 ②③，去名冊查
                 @FeignClient(name = "gh", url = "https://api...")  → 直接打，跳過 ②③
                 後者等於把 Feign 當成純粹的宣告式 HTTP 客戶端，拿來呼叫任何外部 API。

             ⚠⚠ 官方已宣告本專案 feature-complete（Spring Cloud 2022.0.0 起）⚠⚠
                 README 原文：「we're now treating the Spring Cloud OpenFeign project as
                 feature-complete. We are only going to be adding bugfixes ... We suggest
                 migrating over to Spring HTTP Service Clients instead.」
                 白話：只修 bug、不加新功能，建議新專案改用 Spring 內建的
                 @HttpExchange / @ImportHttpServices（Boot 4.1 已內建，零額外依賴，
                 而且 spring-cloud-commons 5.0.2 也已補上負載平衡與斷路器的整合）。
                 這裡仍用 Feign 的理由：課程後續的斷路器 / 重試 / fallback 都接在它上面，
                 而且既有的 Spring Cloud 專案幾乎清一色是它，看得懂是必要技能。

             帶進來的東西（實測依賴樹）：
                 spring-cloud-openfeign-core:5.0.2
                 io.github.openfeign:feign-core:13.6.1
                 io.github.openfeign:feign-slf4j:13.6.1
                 io.github.openfeign:feign-form(-spring):13.6.1 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 的 Micrometer 整合 —— 讓 Feign 呼叫也被追蹤。
             ⚠⚠ 少了它 traceId 會斷在 account ⚠⚠
             症狀：gateway 和 account 的 traceId 一樣，但 loan / card 各自產生新的：
                 [gateway,5474edf9...] [account,5474edf9...] [loan,30850e08...] [card,e499d8d4...]
             原因：Feign 送出的請求沒帶 W3C 的 traceparent 標頭，下游只好開新的 trace。
             🔑 跟手寫的 correlation-id 對照：那個靠 FeignInterceptorConfig 自己塞標頭，
                所以四個服務一直都對得上；OTel 這條要這個依賴才會自動塞。 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-micrometer</artifactId>
        </dependency>
        <!-- Spring Cloud Circuit Breaker 的 Resilience4j 實作。
             ⚠ 名字只寫 circuitbreaker，實際上整套都帶進來了 —— 斷路器、逾時、@Retry、@RateLimiter 都不用再加依賴。
             ⚠ 只有 bulkhead（限併發）沒帶，要用得自己加 resilience4j-bulkhead。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- OpenTelemetry —— 分散式追蹤（Trace）。
             一個依賴帶進 micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp，
             Java 程式碼零改動：HTTP 進出、Feign 呼叫、DB 查詢由框架自動埋點。
             ⚠ 還要 Tempo 容器接收 span，不然只是不斷嘗試送出然後失敗。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 23+ 需要顯式宣告 annotation processor，compile 與 testCompile 皆會套用 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
