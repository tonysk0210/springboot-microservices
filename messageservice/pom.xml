<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>messageservice</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>messageservice</name>
    <description>messageservice</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 把 Function bean 額外開成 HTTP 端點：POST /email 帶 JSON 就能直接觸發，
             不用先架好 RabbitMQ 也能測函式邏輯（路徑 = bean 名稱 = 方法名）。
             ⚠ 這是「開發便利」用的，正式流量走訊息佇列不走 HTTP。
             ⚠ 它會帶進 spring-boot-starter-web → 內嵌 Tomcat，多開一個 port。
               本服務本質上是訊息消費者，不需要對外提供 API，
               哪天覺得多餘可以拿掉，兩個函式照樣能從佇列被觸發。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-function-web</artifactId>
        </dependency>
        <!-- 將 Spring Cloud Stream 連接至 RabbitMQ，讓 Function bean 能透過訊息佇列接收與發送事件。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-rabbit</artifactId>
        </dependency>
        <!-- 同一組通知流程也接上 Kafka，示範事件可保留、可重播的完整往返。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-binder-kafka</artifactId>
        </dependency>

        <!-- Actuator —— OpenTelemetry 的前提。
             ⚠ 追蹤的自動組態（management.tracing.*）住在 actuator 裡，
               少了它下面那個依賴會被載入但「所有 management.* 設定都不生效」，
               而且不會有任何警告。
             順帶提供 /actuator/health，之後進 compose 做 healthcheck 會用到。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OpenTelemetry —— 分散式追蹤（Trace）。
             🔑 對本服務特別重要：它是「訊息驅動」的，沒有 HTTP 請求可以串，
                traceId 是唯一能把它跟 account 的 log 接起來的東西。
             OTel 會自動讀取 AMQP header 裡的 traceparent，延續 account 那邊的 trace。
             ⚠ 還要 Tempo 容器接收 span，不然只是不斷嘗試送出然後失敗。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 使用 Jib 建立 image：./mvnw compile jib:dockerBuild
                 ⚠ compile 不能省 —— Jib 不會自己編譯，漏掉的錯誤訊息是
                   "Obtaining project build output files failed"。
                 各參數的完整說明見 card/pom.xml，那份寫得最詳細。 -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 用本機已有的 image，不要連網（docker:// 前綴）。
                             ⚠ 前提是本機真的有：docker pull eclipse-temurin:25-jre-alpine -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- ⚠ 這只是 metadata（等同 Dockerfile 的 EXPOSE），
                                 實際監聽的埠由 application.yaml 的 server.port 決定，
                                 兩邊要保持一致。
                                 ⚠ 這個 port 只有 function-web 的 HTTP 端點會用到 ——
                                   真正的業務流量走 RabbitMQ，不經過它。 -->
                            <port>9010</port>
                        </ports>
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>message-service</org.opencontainers.image.title>
                            <org.opencontainers.image.description>事件驅動的通知服務（RabbitMQ 收訊息後模擬寄信／發簡訊）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
