# =============================================================================
#  .env —— 真實值放這裡。範本與加密操作說明見 .env.example
#
#  ⚠ 本專案是 demo，這個檔案「會」進 git（.gitignore 裡那兩行刻意註解掉）。
#    所以這把金鑰等同公開，只能加密示範資料，不能加密任何真實機密。
#
#  ⚠ 誰會讀這個檔案：
#      docker compose            ✅ 自動讀，用來展開 compose.yml 的 ${ENCRYPT_KEY}
#      IntelliJ / ./mvnw 跑服務   ❌ 完全不讀！要自己在該視窗設：
#                                    $env:ENCRYPT_KEY = "貼上金鑰"
#    所以改了這裡的值，本機跑的 configserver 不受影響 —— 那是兩條不同的路徑。
#
#  ⚠ 環境變數在 JVM 啟動時就固定了，改完一定要重啟服務／重建容器才生效。
# =============================================================================

# Config Server 的對稱加密金鑰（2026-07-28 產生）
# ⚠ 換掉這把金鑰的話，configyml/*.yml 裡所有既有的 {cipher} 密文都會解不開，
#   症狀是 key 變成 invalid.account.contact-details.email、值是 <n/a>。
ENCRYPT_KEY=560b5cca941e67b3f6a040f1f9c2744508889f5613131b269ff4d16f6c2a3062
