# =============================================================================
#  .env.example —— 環境變數範本（這份「會」進 git，只放變數名和說明，不放真值）
# =============================================================================
#
#  使用方式：
#      複製成 .env 再填入真實值。.env 已經在 .gitignore 裡，不會被 commit。
#
#      PowerShell：  Copy-Item .env.example .env
#
#  誰會讀 .env：
#      docker compose  → 自動讀取專案根目錄的 .env，用來展開 compose.yml 裡的 ${VAR}
#      本機直接跑 jar  → 不會自動讀！要自己設環境變數，見下方說明
# =============================================================================


# -----------------------------------------------------------------------------
#  ENCRYPT_KEY —— Config Server 的對稱加密金鑰
# -----------------------------------------------------------------------------
#  作用：讓設定檔裡可以放加密過的值。Config Server 供應設定時自動解密，
#        客戶端（account / loan / card）收到明文，不需要知道金鑰。
#
#  ⚠ 為什麼不寫在 configserver/src/main/resources/application.yaml？
#    因為那個檔案會 commit 進 git，而本專案的 repo 是 public。
#    加密的前提是「密文可以外流、金鑰不行」，兩個放一起就完全沒意義了。
#
#  ⚠ 金鑰換掉的話，所有既有的 {cipher} 密文都會解不開（沒有自動輪替機制）。
#
#  產生一把新的（PowerShell）：
#      $b = New-Object byte[] 32
#      [Security.Cryptography.RandomNumberGenerator]::Fill($b)
#      -join ($b | ForEach-Object { $_.ToString('x2') })
#
#  ⚠ 本機直接用 mvnw 跑 configserver 時，.env 不會被自動讀取，要自己設：
#      $env:ENCRYPT_KEY = "貼上你的金鑰"
#      cd configserver; ./mvnw spring-boot:run
#    （只在當前 PowerShell 視窗有效，關掉就沒了）
# -----------------------------------------------------------------------------
ENCRYPT_KEY=在這裡填入你的金鑰

# -----------------------------------------------------------------------------
#  加密流程：把一個值加密後放進設定檔
# -----------------------------------------------------------------------------
#  整體概念：
#      你 → POST /encrypt → 拿到密文 → 貼進 configyml/*.yml → push
#      GitHub 上存的是密文；configserver 供應設定時解密；客戶端收到明文。
#      解密是 configserver 做的，account / loan / card 不知道金鑰存在。
#
#  ---------------------------------------------------------------------------
#  步驟 1：帶金鑰啟動 configserver
#
#      $env:ENCRYPT_KEY = "貼上金鑰"
#      cd configserver; ./mvnw spring-boot:run
#
#    忘記設的話，/encrypt 會回錯誤並抱怨 No key was installed for encryption service。
#
#  ---------------------------------------------------------------------------
#  步驟 2：加密（另開一個 PowerShell 視窗）
#
#      $c = Invoke-RestMethod -Uri http://localhost:8071/encrypt -Method Post `
#             -Body "account-support@bank.com" -ContentType "text/plain"
#      $c
#
#    用 Invoke-RestMethod 不要用 curl —— PowerShell 的 curl 是 Invoke-WebRequest
#    的別名，處理 POST body 與 content-type 的行為不同，很容易踩坑。
#
#    一次加密三個 email：
#      @{
#        account = "account-support@bank.com"
#        loan    = "loan-support@bank.com"
#        card    = "card-support@bank.com"
#      }.GetEnumerator() | ForEach-Object {
#        $c = Invoke-RestMethod -Uri http://localhost:8071/encrypt -Method Post `
#               -Body $_.Value -ContentType "text/plain"
#        "{0,-8} : '{{cipher}}{1}'" -f $_.Key, $c
#      }
#
#  ---------------------------------------------------------------------------
#  步驟 3：貼進設定檔，前面加 {cipher}，並用「單引號」
#
#      # configyml/account.yml
#      account:
#        contact-details:
#          email: '{cipher}AQBd3kf9x2mP...'
#
#    ⚠ 單引號不能省。{ 開頭沒引號時，YAML 會把它當成 flow mapping 解析而失敗。
#
#  ---------------------------------------------------------------------------
#  步驟 4：commit + push（git 後端只認 GitHub 上的內容，沒 push 等於沒改）
#
#  ---------------------------------------------------------------------------
#  步驟 5：驗證
#
#      http://localhost:8071/account/default
#          → email 應該顯示「解密後的明文」
#
#      重啟 account 後打 http://localhost:8080/api/contact-info
#          → 一樣是明文
#
#    解密失敗的症狀：key 變成 invalid.account.contact-details.email、值是 <n/a>。
#    原因通常是 configserver 重啟時用了不同的金鑰，或密文貼漏字（很長，容易截斷）。
#
#  ---------------------------------------------------------------------------
#  解密（驗證用；正式環境應該關掉或加上認證）
#
#      Invoke-RestMethod -Uri http://localhost:8071/decrypt -Method Post `
#        -Body $c -ContentType "text/plain"
#
#  ---------------------------------------------------------------------------
#  兩個看起來像出錯、其實正常的現象：
#
#  1. 同一個值每次加密，密文都不一樣 —— 因為每次用不同的隨機 IV。
#     這是正確的密碼學行為（否則相同的值會產生相同密文，能被比對出來）。
#
#  2. 密文很長（比原文長很多）—— 因為含 IV 與 padding，再做 hex 編碼。
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
