# =============================================================================
#  .env 的範本與加密操作備忘
# =============================================================================
#  誰會讀 .env：
#      docker compose   自動讀專案根目錄的 .env，用來展開 compose.yml 的 ${VAR}
#      ./mvnw 跑服務    ❌ 不會讀，要自己 $env:XXX = "..."
#
#  ⚠ 本專案是 demo，刻意讓 .env（含金鑰）一起進 git，方便換機器直接跑。
#    代價：這把金鑰等同公開，只能用來加密示範資料，不能加密任何真實機密。
#    正式專案應該把 .env 加進 .gitignore，只留這份範本。
# =============================================================================


#  Config Server 的對稱加密金鑰。設定檔裡可以放 {cipher} 密文，
#  configserver 供應設定時自動解密，三個服務收到明文、不需要知道金鑰。
#
#  ⚠ 換金鑰的話，所有既有的 {cipher} 密文都會解不開（沒有輪替機制）。
#
#  產生一把新的（PowerShell 一行）：
#      [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
ENCRYPT_KEY=在這裡填入你的金鑰

# -----------------------------------------------------------------------------
#  怎麼把一個值加密後放進設定檔
# -----------------------------------------------------------------------------
#  1. 帶金鑰啟動 configserver（沒設的話 /encrypt 會回 No key was installed）
#         $env:ENCRYPT_KEY = "貼上金鑰"
#         cd configserver; ./mvnw spring-boot:run
#
#  2. 加密（另開一個視窗）
#         Invoke-RestMethod http://localhost:8071/encrypt -Method Post `
#           -Body "account-support@bank.com" -ContentType "text/plain"
#     ⚠ 用 Invoke-RestMethod 不要用 curl —— PowerShell 的 curl 是
#       Invoke-WebRequest 的別名，處理 POST body 的行為不同。
#
#  3. 貼進 configyml/*.yml，前面加 {cipher}，並用「單引號」
#         email: '{cipher}AQBd3kf9x2mP...'
#     ⚠ 單引號不能省 —— { 開頭沒引號時 YAML 會當成 flow mapping 而解析失敗。
#
#  4. commit + push（git 後端只認 GitHub 上的內容）
#
#  5. 驗證 http://localhost:8071/account/default → email 應顯示明文
#     解不開的症狀：key 變成 invalid.account.contact-details.email、值是 <n/a>
#     （通常是金鑰不同，或密文很長貼漏了字）
#
#  兩個看起來像出錯、其實正常的現象：
#    同一個值每次加密密文都不同 —— 每次用不同的隨機 IV，這是正確的密碼學行為
#    密文比原文長很多 —— 含 IV 與 padding，再做 hex 編碼
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
#  驗證開關（容器版）
# -----------------------------------------------------------------------------
#  空 = 不驗證（預設）；填 auth = gatewayserver 開啟 OAuth2 驗證。
#  ⚠ 跟 docker compose --profile auth 是兩件事：那個決定 Keycloak 容器起不起來，
#    這個決定 gateway 要不要驗 token。完整流程兩個都要開。
#  ⚠ 本機用 mvnw 跑的話這個檔案讀不到，改用 -Dspring-boot.run.profiles=auth
GATEWAY_PROFILE=

#  Keycloak 管理員（只有 --profile auth 時用得到）
#  ⚠ KC_BOOTSTRAP_ADMIN_* 只在資料庫是空的時候才建立管理員，
#    改帳密之後既有的 keycloak-data volume 不會跟著變。
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
#  之後會用到的，先留位置
#  （跟上面的加密金鑰無關，只是同樣屬於「不該散落在設定檔裡的機密」）
# -----------------------------------------------------------------------------
#  private config repo 才需要，讓 configserver clone 得到（password 填 GitHub
#  token，不是登入密碼）
# SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME=tonysk0210
# SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD=

#  等 H2 換成 Postgres 時會用到。
#  ⚠ postgres 容器本身只認明文（它不懂 {cipher}），所以這裡一定要放明文；
#    三個 Spring 服務那側則可以改用 configyml 裡的 {cipher} 密文。
# POSTGRES_PASSWORD=
