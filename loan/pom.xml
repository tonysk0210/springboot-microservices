<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>loan</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>loan</name>
    <description>loan</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Config Client —— 啟動時去 Config Server (8071) 拿 config/loan.yml
             （檔名 = spring.application.name），並帶進 @RefreshScope、/actuator/refresh。
             版本由下方 BOM 決定，不寫 <version>。

             ⚠ 必須在 application.yaml 設 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）：
                 import: "configserver:http://localhost:8071/"           連不上就失敗
                 import: "optional:configserver:http://localhost:8071/"  連不上改用本地設定
               容器裡要把 localhost 換成服務名 configserver。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- RabbitMQ 版（這個場景最常用） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        ===================================================================
                         用 Buildpacks 建 container image 的設定
                        ===================================================================

                        ⚠ 這一段「只」影響 mvn spring-boot:build-image，與 Dockerfile 無關。
                          docker build 走的是 Dockerfile，完全不會讀 pom.xml。
                          兩者是兩套獨立的建置方式：
                            Buildpacks  → 不必寫 Dockerfile，自動決定基底 image、分層、
                                          非 root 使用者、JVM 記憶體計算（loan 用這個方式）
                            Dockerfile  → 自己掌控每個細節（account 用這個方式）

                        ===================================================================
                         <name> image 名稱
                        ===================================================================
                        兩個 Maven 變數會自動展開，升版時只要改上方的 <version> 一處：
                            ${project.artifactId} → loan
                            ${project.version}    → 0.0.1-SNAPSHOT
                            結果：anthonysk/loan:0.0.1-SNAPSHOT

                        anthonysk 是 Docker Hub 的命名空間，必須是真實帳號才能 docker push。
                        只在本機跑的話名稱可以隨意，不影響功能。

                        ===================================================================
                         <env> 兩種前綴意義完全不同
                        ===================================================================
                        BP_*   建置期設定，告訴 buildpack「怎麼建」，不會進入容器環境
                               例：<BP_JVM_VERSION>25</BP_JVM_VERSION>
                        BPE_*  執行期環境變數，等同 Dockerfile 的 ENV
                               BPE_DEFAULT_XXX 是「預設值」，可被 docker run 的 e 參數覆蓋

                        這裡把資料庫預設成記憶體模式，語意明確表示「容器內資料不持久」，
                        避免資料悄悄寫進 /home/cnb/h2db/ 然後隨容器重建消失。
                        （application.yaml 的預設是 jdbc:h2:file:~/h2db/loandb）

                        ⚠ docker image inspect 的 Config.Env 欄位「看不到」BPE_* 設定！
                          因為 Buildpacks 是把它寫成 /layers/ 裡的啟動腳本，由 CNB launcher
                          在容器啟動時才載入，不在 image 的靜態 metadata 裡。
                          正確驗證方式是跑起來看 log：
                              docker logs loan | Select-String "jdbc:h2"
                              → 應顯示 url=jdbc:h2:mem:loandb

                        ===================================================================
                         操作指令
                        ===================================================================
                        建 image（需要 Docker 在執行中；第一次會下載約 1~2 GB 的 builder）：
                            cd D:\Fork\github\springboot-microservices\loan
                            .\mvnw spring-boot:build-image

                        跑起來（加 d 參數背景執行、name 參數命名為 loan）：
                            docker run -d (name=loan) -p 8090:8090 anthonysk/loan:0.0.1-SNAPSHOT

                        ⚠ 上面的 (name=loan) 是因為 XML 註解不能出現「連續兩個」減號，
                          無法寫出長參數的前綴。實際輸入時 name 前面要加兩個減號。
                          （單一減號完全合法，所以 0.0.1-SNAPSHOT、swagger-ui 都正常寫。）

                        ⚠ port 映射是 8090:8090，不是 8090:8080！
                          因為 loan 的 server.port 設定是 8090，容器內 App 聽的就是 8090。
                          寫成 8090:8080 的話容器會正常啟動，但永遠連不上，且沒有錯誤訊息。

                        驗證：
                            curl http://localhost:8090/actuator/health
                            → {"groups":["liveness","readiness"],"status":"UP"}
                            瀏覽器：http://localhost:8090/swagger-ui/index.html

                        收工：
                            docker rm -f loan

                        ⚠ Paketo 的 run image 是 distroless 風格，「沒有 shell」，
                          所以 docker exec loan sh 會失敗，除錯只能靠 docker logs。
                    -->
                    <image>
                        <name>anthonysk/${project.artifactId}:${project.version}</name>
                        <env>
                            <BPE_DEFAULT_SPRING_DATASOURCE_URL>jdbc:h2:mem:loandb</BPE_DEFAULT_SPRING_DATASOURCE_URL>
                            <!--
                                BP_OCI_* 會被轉成 OCI 標準的 image label（純 metadata）。
                                查看方式：docker image inspect 的 Config.Labels 欄位

                                推到 ghcr.io 時，GitHub 的 package 頁面會用這些 label 顯示
                                描述，並「嘗試」把 image 連結到 source 指向的 repo。

                                🔑 為什麼 Buildpacks 只設 label 就夠，account 卻還要額外的
                                   annotation？因為 Buildpacks 產出的是舊的 Docker v2
                                   manifest，該格式不支援 annotation，GitHub 只能退回去讀
                                   config label。而 account 用 buildx 產出的是 OCI manifest，
                                   GitHub 會優先找 manifest annotation，找不到就空白
                                   （不會退回讀 label）。
                                   → 差異來自 manifest 格式，不是設定寫錯。

                                ⚠ 自動連結 repo「不保證成功」。官方文件指出命令列推送只有用
                                  GitHub Actions + GITHUB_TOKEN 才保證自動連結；手動推送若
                                  沒連上，要到 Package settings 手動 Connect repository。
                            -->
                            <BP_OCI_TITLE>loan-service</BP_OCI_TITLE>
                            <BP_OCI_DESCRIPTION>貸款資料的 REST API</BP_OCI_DESCRIPTION>
                            <BP_OCI_AUTHORS>Tony Shangkuan</BP_OCI_AUTHORS>
                            <BP_OCI_SOURCE>https://github.com/tonysk0210/springboot-microservices</BP_OCI_SOURCE>
                        </env>
                    </image>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
