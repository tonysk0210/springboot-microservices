<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>loan</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>loan</name>
    <description>loan</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Config Client —— 啟動時向 Config Server 拿 configyml/loan.yml
             （檔名 = spring.application.name），並帶進 /actuator/refresh。
             ⚠ 必須搭配 application.yaml 的 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder —— 提供 /actuator/busrefresh，
             打一次讓所有服務重抓設定。
             ⚠ 四個服務都要加，少一個那個服務收不到廣播且沒有錯誤訊息。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時連不上 broker。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Buildpacks：不用自己寫 Dockerfile，Maven 幫你把 image 建好。
                            指令：./mvnw spring-boot:build-image
                        這一段設定只有那個指令會讀。docker build 走的是 Dockerfile，
                        完全不會看 pom.xml。

                        下面 env 裡的兩種前綴，意思差很多：
                            BP_*   給「建 image 的時候」用，建完就沒了，容器裡看不到
                            BPE_*  給「容器跑起來的時候」用，等於 Dockerfile 的 ENV
                                   名字帶 DEFAULT 的（BPE_DEFAULT_XXX）表示只是預設值，
                                   docker run -e 或 compose 的 environment 都蓋得掉

                        ⚠ 用 docker image inspect 看不到 BPE_* 設的變數，很容易以為沒生效。
                          它不是存在 image 的 metadata 裡，而是被寫成一段啟動腳本，
                          容器跑起來才載入。想確認有沒有生效要看 log：
                              docker logs loan | Select-String "jdbc:h2"

                        ⚠ 這種 image 裡面幾乎沒有任何工具 —— 實測連 sh、wget、curl 都找不到。
                          後果有兩個：docker exec 進不去除錯，compose 也做不了 healthcheck。

                        ⚠ Paketo 會自己算 JVM 該用多少記憶體，而且會蓋掉我們設的
                          MaxRAMPercentage。在 700m 的上限下它只分 46MB 給 heap，
                          服務啟動到一半就會 OOM 死掉。
                          解法寫在 compose.yml：調低 BPL_JVM_THREAD_COUNT，把記憶體讓回給 heap。
                    -->
                    <image>
                        <name>anthonysk/${project.artifactId}:${project.version}</name>
                        <env>
                            <BPE_DEFAULT_SPRING_DATASOURCE_URL>jdbc:h2:mem:loandb</BPE_DEFAULT_SPRING_DATASOURCE_URL>
                            <!-- BP_OCI_* 會變成 image 上的標籤（label），純粹是給人看的資訊，
                                 不影響程式執行。推到 ghcr.io 之後，GitHub 的 package 頁面
                                 就是靠它顯示描述。

                                 🔑 為什麼 account 那邊還要多寫一串 annotation 參數？
                                    因為兩者產出的 image 格式不一樣：Buildpacks 產的是舊格式，
                                    GitHub 讀得懂上面的 label；account 用 buildx 產的是新格式，
                                    GitHub 只認 annotation，不會退回去讀 label。 -->
                            <BP_OCI_TITLE>loan-service</BP_OCI_TITLE>
                            <BP_OCI_DESCRIPTION>貸款資料的 REST API</BP_OCI_DESCRIPTION>
                            <BP_OCI_AUTHORS>Tony Shangkuan</BP_OCI_AUTHORS>
                            <BP_OCI_SOURCE>https://github.com/tonysk0210/springboot-microservices</BP_OCI_SOURCE>
                        </env>
                    </image>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
