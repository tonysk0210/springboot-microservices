<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>loan</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>loan</name>
    <description>loan</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud 發行列車版本（年份.次版.修訂，非語意化版本），給下方 BOM 用。
             ⚠ 必須與 Spring Boot 4.1.0 相容。配錯只會在啟動時噴 NoSuchMethodError，
               不會有明確的版本錯誤訊息。對照表 https://spring.io/projects/spring-cloud -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI + Swagger UI 整合套件；3.x 對應 Spring Boot 4.x（2.x 只支援 Boot 3.x）http://localhost:8080/swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Config Client —— 啟動時向 Config Server 拿 configyml/loan.yml
             （檔名 = spring.application.name），並帶進 /actuator/refresh。
             ⚠ 必須搭配 application.yaml 的 spring.config.import，否則啟動失敗
               （No spring.config.import property has been defined）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bus + RabbitMQ binder —— 提供 /actuator/busrefresh，
             打一次讓所有服務重抓設定。
             ⚠ 四個服務都要加，少一個那個服務收不到廣播且沒有錯誤訊息。
             ⚠ 需要 RabbitMQ 在跑，否則啟動時連不上 broker。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Spring Cloud 的版本對照表（BOM），所以上面的 spring-cloud 依賴不必寫 <version>。
         Spring Boot 的依賴不需要，因為 spring-boot-starter-parent 已內建版本管理。
         ⚠ type=pom + scope=import 不能省，否則版本管理會安靜地失效。
         ⚠ 只管版本，不引入任何函式庫。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Buildpacks 建 image（不必寫 Dockerfile）：
                            ./mvnw spring-boot:build-image
                        這段只影響該指令；docker build 走 Dockerfile，不會讀 pom.xml。

                        <env> 的兩種前綴意義完全不同：
                            BP_*   建置期設定，不會進入容器環境
                            BPE_*  執行期環境變數，等同 Dockerfile 的 ENV
                                   BPE_DEFAULT_* 是預設值，可被 docker run -e 覆蓋

                        ⚠ docker image inspect 的 Config.Env「看不到」BPE_*。
                          Buildpacks 把它寫成 /layers/ 裡的啟動腳本，由 CNB launcher
                          在啟動時載入，不在 image 的靜態 metadata 裡。
                          驗證要看 log：docker logs loan | Select-String "jdbc:h2"

                        ⚠ run image 是 distroless 風格 —— 實測連 /bin/sh、wget、curl
                          都沒有。所以 docker exec 進不去，compose 也無法做 healthcheck。

                        ⚠ Paketo 的記憶體計算器會自己算 -Xmx 並蓋掉 MaxRAMPercentage。
                          700m 上限下預設只分到 46MB heap，啟動就 OOM；
                          compose.yml 用 BPL_JVM_THREAD_COUNT 調低執行緒假設來修正。
                    -->
                    <image>
                        <name>anthonysk/${project.artifactId}:${project.version}</name>
                        <env>
                            <BPE_DEFAULT_SPRING_DATASOURCE_URL>jdbc:h2:mem:loandb</BPE_DEFAULT_SPRING_DATASOURCE_URL>
                            <!-- BP_OCI_* → OCI image label（純 metadata），ghcr.io 的
                                 package 頁面靠它顯示描述。
                                 🔑 Buildpacks 產的是 Docker v2 manifest，GitHub 讀得到
                                    config label；account 用 buildx 產 OCI manifest，
                                    GitHub 只讀 manifest annotation，所以那邊要額外設定。 -->
                            <BP_OCI_TITLE>loan-service</BP_OCI_TITLE>
                            <BP_OCI_DESCRIPTION>貸款資料的 REST API</BP_OCI_DESCRIPTION>
                            <BP_OCI_AUTHORS>Tony Shangkuan</BP_OCI_AUTHORS>
                            <BP_OCI_SOURCE>https://github.com/tonysk0210/springboot-microservices</BP_OCI_SOURCE>
                        </env>
                    </image>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
