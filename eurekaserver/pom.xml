<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>eurekaserver</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>eurekaserver</name>
    <description>eurekaserver</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Eureka Server —— 註冊中心本體。提供兩樣東西：
                 /eureka/*    客戶端註冊與查詢用的 REST API（機器在用）
                 /            儀表板網頁（人在看，http://localhost:8070）

             ⚠ 必須搭配 @EnableEurekaServer（見 EurekaserverApplication）。
               🔑 這點跟 client 端剛好相反 —— client 的 @EnableEurekaClient 在 5.0.2
                  已被移除、加了編譯不過；server 這個註解則「還是必要的」，
                  少了它服務照樣啟動，但 8070 上什麼都沒有。

             ⚠ 它內含一份 eureka-client（Eureka 天生設計成叢集，每台 Server 靠內建的
               client 去跟別台互相複製名冊）。我們只跑一台，所以 application.yml 要用
               eureka.client.register-with-eureka / fetch-registry: false 把它關掉。
               不關的話會一直嘗試連 localhost:8761 並噴 TransportException。

             🔑 它會自己帶進 spring-boot-starter-web 和 spring-boot-starter-freemarker
                （儀表板是 Freemarker 樣板寫的），所以本 pom 不用另外加 web starter。
                另外也帶進 spring-cloud-starter-loadbalancer 和 Jersey 3。

             ⚠ 啟動時這兩則訊息都來自這條依賴，是雜訊不是錯誤：
                 WARNING: sun.misc.Unsafe::objectFieldOffset ... by xstream
                     Eureka 用 XStream 做 XML 序列化，它在 Java 25 上碰了即將移除的
                     Unsafe API。只能等 XStream 更新，無法從這裡消掉。
                 INFO: Failed to set up a Bean Validation provider
                     classpath 上沒有 hibernate-validator。Eureka Server 用不到，
                     不用為了消掉它去加 spring-boot-starter-validation。

             ⚠ 傳遞依賴 com.netflix.eureka:eureka-client:2.0.6 把 httpclient 釘死在
               4.5.3（CVE-2020-13956，URI 解析問題，CVSS 5.3）。Spring Boot 的 BOM
               只管 httpclient5，管不到 4.x 這條線。要消掉掃描器警告就在下方
               dependencyManagement 補一筆 httpclient:4.5.14（純修補版，API 相容）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!-- Spring Cloud Bus + RabbitMQ —— 提供 /actuator/busrefresh，也讓本服務收得到
             別人發的 refresh 廣播。加它是為了「五個服務行為一致」，實際效益有限：

             ⚠ eurekaserver 的設定幾乎都是「啟動時綁死、refresh 改不動」的：
                   server.port                  Netty 已綁定
                   eureka.instance.hostname     DiscoveryClient 已初始化
                   eureka.client.*              同上
               而且 configyml/eurekaserver.yml 是空的，遠端也沒東西可以下發。
               🔑 真正 refresh 得動的只有 logging.level.* —— 好處是可以遠端把 Eureka 的
                  log 調成 DEBUG 除錯，不用重啟。

             ⚠ 需要 RabbitMQ 在跑，否則背景會無限重連（不影響啟動，但 log 很吵）。
             ⚠ 容器裡要由 compose 設 SPRING_RABBITMQ_HOST: rabbitmq ——
               預設是 localhost，而容器裡的 localhost 是容器自己。
               所以 compose.yml 的 eurekaserver 要改成繼承 common.yml 的 configserver-base
               （那一層帶這個環境變數和 depends_on rabbitmq），不再只繼承 resource-limits。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Jib 建 image（不用寫 Dockerfile，跟 configserver / card 同一套）：
                     ./mvnw compile jib:dockerBuild
                 ⚠ compile 不能省，Jib 不會自己編譯。漏掉的錯誤訊息是
                   Obtaining project build output files failed。 -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 跟其他服務同一個基底：alpine 有 wget（compose 的 healthcheck 要用）
                             和 sh（進去除錯要用）。
                             docker:// = 用本機已經有的，不去網路抓（理由見 card/pom.xml）。
                             ⚠ 前提是本機真的有：docker pull eclipse-temurin:25-jre-alpine -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- 等同 Dockerfile 的 EXPOSE -->
                            <port>8070</port>
                        </ports>
                        <!-- 刻意不設 <environment>：
                             EUREKA_HOST 在容器裡要是服務名 eurekaserver、本機要是 localhost，
                             CONFIGSERVER_HOST 同理 —— 都屬於「網路拓撲」，由 compose 在執行期
                             提供，不該寫死進 image。 -->
                        <!-- 不要用 root 執行 -->
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>eurekaserver</org.opencontainers.image.title>
                            <org.opencontainers.image.description>Spring Cloud Netflix Eureka Server（服務註冊中心，單機模式）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
