<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>eurekaserver</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>eurekaserver</name>
    <description>eurekaserver</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Eureka Server：提供服務註冊、查詢 API 與管理儀表板。
             必須搭配 @EnableEurekaServer 才會啟用 Server 功能。
             本專案只啟動單一 Server，因此 application.yml 關閉
             register-with-eureka 與 fetch-registry，避免它把自己當成 Client。
             此 starter 也會傳遞引入 Web、儀表板與 LoadBalancer 相關依賴。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 覆寫 Eureka 傳遞引入的舊版 HttpClient，修正 CVE-2020-13956。 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.14</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Jib 不需要 Dockerfile；先 compile，再執行 jib:dockerBuild 建立本機 image。 -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 跟其他服務同一個基底：alpine 有 wget（compose 的 healthcheck 要用）
                             和 sh（進去除錯要用）。
                             docker:// = 用本機已經有的，不去網路抓（理由見 card/pom.xml）。
                             ⚠ 前提是本機真的有：docker pull eclipse-temurin:25-jre-alpine -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- 等同 Dockerfile 的 EXPOSE -->
                            <port>8070</port>
                        </ports>
                        <!-- 刻意不設 <environment>：
                             EUREKA_HOST 在容器裡要是服務名 eurekaserver、本機要是 localhost，
                             CONFIGSERVER_HOST 同理 —— 都屬於「網路拓撲」，由 compose 在執行期
                             提供，不該寫死進 image。 -->
                        <!-- 不要用 root 執行 -->
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>eurekaserver</org.opencontainers.image.title>
                            <org.opencontainers.image.description>Spring Cloud Netflix Eureka Server（服務註冊中心，單機模式）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
