<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>gatewayserver</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gatewayserver</name>
    <description>gatewayserver</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Eureka Client：註冊 Gateway 並取得服務清單；lb://SERVICE
             再由 Spring Cloud LoadBalancer 選擇可用實例。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Spring Cloud Bus：透過 RabbitMQ 廣播設定更新；Broker 未啟動時會持續重連。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-amqp</artifactId>
        </dependency>
        <!-- Spring Cloud Gateway 的 WebFlux／Reactor 實作：以非阻塞方式進行路由轉送，
             並支援路由斷言與 Gateway filters；相關設定使用 spring.cloud.gateway.server.webflux.*。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- WebFlux Gateway 的 Reactive Circuit Breaker：整合 Reactor Resilience4j，
             供 Gateway CircuitBreaker filter 執行斷路保護與 fallback。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
        <!-- Reactive Redis 支援：以非阻塞方式存取 Redis，
             可供 Gateway 的 RedisRateLimiter 儲存與計算限流狀態。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- Micrometer 的 Prometheus registry：將 JVM、HTTP 與應用程式指標轉成
             Prometheus 可抓取的格式；另需在 Actuator exposure 中開放 prometheus 端點。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- OpenTelemetry —— 分散式追蹤（Trace）。
             一個依賴帶進 micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp，
             Java 程式碼零改動：HTTP 進出、Feign 呼叫、DB 查詢由框架自動埋點。
             ⚠ 還要 Tempo 容器接收 span，不然只是不斷嘗試送出然後失敗。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- ── OAuth2 Resource Server（三個一組，缺一不可）───────────────────
             Gateway 在 OAuth2 裡的角色是「資源伺服器」：只負責「驗」token，
             發 token 是 Keycloak 的事。
                 ① 地基     filter chain、授權規則
                 ② 認方式   從 Authorization: Bearer xxx 取出 token
                 ③ 驗簽章   用 Keycloak 的公鑰檢查 JWT 沒被竄改
             ⚠ 還要 yaml 的 jwk-set-uri 指向 Keycloak 的公鑰清單，
               沒設的話所有請求 401，而錯誤訊息不會說是缺設定。 -->
        <!-- ① Spring Security 本體 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- ② 宣告「我是資源伺服器」，改用 Bearer token 驗身分 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- ③ JWT 的簽章驗證（JOSE = JSON 簽章加密標準，底層是 Nimbus）
             ⚠ 少了它啟動就 NoClassDefFoundError。
             ⚠ 不要另外加 jjwt —— 那是「自己發 token」用的，跟 Keycloak 重複。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 覆寫 Eureka 傳遞引入的舊版 HttpClient，修正 CVE-2020-13956。 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.14</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 使用 Jib 建立 image：./mvnw compile jib:dockerBuild -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <from>
                        <!-- 使用本機的 Java 25 Alpine image。 -->
                        <image>docker://eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>anthonysk/${project.artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <ports>
                            <!-- image 暴露的服務埠；實際映射由 Compose 設定。 -->
                            <port>8072</port>
                        </ports>
                        <!-- 不要用 root 執行 -->
                        <user>nobody</user>
                        <labels>
                            <org.opencontainers.image.title>gatewayserver</org.opencontainers.image.title>
                            <org.opencontainers.image.description>Spring Cloud Gateway（API 閘道，統一入口與路由）</org.opencontainers.image.description>
                            <org.opencontainers.image.authors>Tony Shangkuan</org.opencontainers.image.authors>
                            <org.opencontainers.image.source>https://github.com/tonysk0210/springboot-microservices</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>
